<dialog class="lightbox" data-lightbox aria-label="Photo viewer">
  <figure>
    <img data-lightbox-image width="1000" height="1000" alt="">
    <figcaption data-lightbox-caption hidden></figcaption>
  </figure>
  <button class="lightbox-nav prev" type="button" data-lightbox-prev aria-label="Previous photo">‹</button>
  <button class="lightbox-nav next" type="button" data-lightbox-next aria-label="Next photo">›</button>
  <button class="lightbox-close" type="button" data-lightbox-close aria-label="Close photo viewer">×</button>
</dialog>
