<div class="template-404 page-width page-margin center">
  <p class="template-404__code">
    {{ 'templates.404.subtext' | t }}
  </p>
  <h1 class="title">
    {{ 'templates.404.title' | t }}
  </h1>
  <p class="template-404__lede">
    That link may be out of date. Browse the shop, or tell us what you want made.
  </p>
  <div class="template-404__actions">
    <a href="{{ routes.all_products_collection_url }}" class="button">
      {{ 'general.continue_shopping' | t }}
    </a>
    <a href="/pages/custom-project" class="button button--secondary">Start a Custom Project</a>
  </div>
</div>
