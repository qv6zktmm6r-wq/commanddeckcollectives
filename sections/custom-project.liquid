<section class="contact-band intake-band cd">
  <div class="shell">
    <div class="contact-card">
      <div>
        <span class="section-kicker">Custom project intake</span>
        <h1 class="intake-title">Tell us what you want to create.</h1>
        <p>Share the project type, quantity, timeline and what the piece needs to represent. Command Deck can follow up with next steps and any artwork requirements.</p>
      </div>
      {%- render 'cd-contact-form',
        form_id: 'ContactForm-custom-project',
        placeholder: 'Describe the idea, audience, desired look, and any artwork you already have.',
        submit_label: 'Send Project Request'
      -%}
    </div>
  </div>
</section>

{% schema %}
{ "name": "Custom project form", "settings": [], "presets": [{ "name": "Custom project form" }] }
{% endschema %}
