
<section class="contact-band" style="min-height:70vh;padding-top:110px"><div class="shell"><div class="contact-card"><div><span class="section-kicker">Custom project intake</span><h1 style="font-family:Georgia,serif;font-size:clamp(48px,6vw,82px);font-weight:500;line-height:.95;margin:16px 0">Tell us what you want to create.</h1><p style="color:#bdb7ad;line-height:1.75">Share the project type, quantity, timeline and what the piece needs to represent. Command Deck can follow up with next steps and any artwork requirements.</p></div>{% form 'contact', class: 'contact-form' %}<input required name="contact[name]" placeholder="Name"><input required type="email" name="contact[email]" placeholder="Email"><input name="contact[organization]" placeholder="Unit / business / organization"><select name="contact[project_type]"><option>Project type</option><option>Challenge coins</option><option>Apparel & merchandise</option><option>Awards & recognition</option><option>Bulk order</option><option>Custom project</option></select><input name="contact[quantity]" placeholder="Estimated quantity"><input name="contact[needed_by]" placeholder="Needed-by date"><textarea class="full" required name="contact[body]" placeholder="Describe the idea, audience, desired look, budget range, and any artwork you already have."></textarea><button class="btn primary full" type="submit">Send Project Request →</button>{% endform %}</div></div></section>
{% schema %}{"name":"Custom project form","settings":[],"presets":[{"name":"Custom project form"}]}{% endschema %}
