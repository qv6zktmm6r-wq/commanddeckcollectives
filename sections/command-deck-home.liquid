
<header class="site-header"><div class="shell header-inner"><a class="brand" href="{{ routes.root_url }}"><img src="{{ 'command-deck-logo.webp' | asset_url }}" alt="{{ shop.name | escape }}"></a><nav class="nav" aria-label="Primary"><a class="active" href="{{ routes.root_url }}">Home</a><a href="{{ routes.all_products_collection_url }}">Shop</a><a href="/pages/custom-project">Custom Orders</a><a href="#services">Services</a><a href="{{ routes.collections_url }}">Collections</a><a href="#our-work">Our Work</a><a href="#about">About</a><a href="#contact">Contact</a></nav><div class="header-actions"><a aria-label="Search" href="{{ routes.search_url }}">⌕</a><a aria-label="Account" href="{{ routes.account_url }}">♙</a><a aria-label="Cart" href="{{ routes.cart_url }}">🛒</a></div><button class="menu-toggle" data-menu-toggle aria-label="Menu" aria-expanded="false">☰</button></div><nav class="mobile-panel" data-mobile-panel aria-label="Mobile navigation"><a href="{{ routes.root_url }}">Home</a><a href="{{ routes.all_products_collection_url }}">Shop</a><a href="/pages/custom-project">Custom Orders</a><a href="#services">Services</a><a href="{{ routes.collections_url }}">Collections</a><a href="#our-work">Our Work</a><a href="#about">About</a><a href="#contact">Contact</a></nav></header>
<main><section class="hero"><div class="shell hero-inner"><div class="hero-copy"><p class="eyebrow">{{ section.settings.eyebrow }}</p><h1>{{ section.settings.headline_line_1 }} <span>{{ section.settings.headline_line_2 }}</span></h1><p class="hero-lede">{{ section.settings.lede }}</p><div class="hero-actions"><a class="btn primary" href="{{ section.settings.primary_link }}">{{ section.settings.primary_label }} →</a><a class="btn secondary" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label }}</a></div></div><div class="hero-stage" aria-hidden="true"><div class="stage-card"><strong>People<br>Ideas<br>Teams<br>Businesses<br>Legacies</strong><small>Custom made for a higher purpose.</small></div><div class="coin-shadow"></div><div class="stage-plinth"></div><div class="display-coin"><img src="{{ 'command-deck-logo.webp' | asset_url }}" alt=""></div></div></div></section>
<section class="service-strip" id="services"><div class="service-grid">{% for block in section.blocks %}<a class="service-card" href="{{ block.settings.link }}" {{ block.shopify_attributes }}><span class="service-art"></span><span class="service-info"><h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p><span class="arrow">›</span></span></a>{% endfor %}</div></section>
<section class="trust"><div class="shell trust-grid"><div class="trust-item"><span class="trust-icon">✦</span><span><strong>Veteran Owned</strong><small>Service never stops</small></span></div><div class="trust-item"><span class="trust-icon">★</span><span><strong>Quality Craftsmanship</strong><small>Built to last</small></span></div><div class="trust-item"><span class="trust-icon">⚙</span><span><strong>Custom Designs</strong><small>Bring your vision to life</small></span></div><div class="trust-item"><span class="trust-icon">●●●</span><span><strong>Bulk Orders Welcome</strong><small>Teams · Businesses · Individuals</small></span></div><div class="trust-item"><span class="trust-icon">▣</span><span><strong>Fast Fulfillment</strong><small>Ready when you are</small></span></div></div></section>
<section class="content-section" id="our-work"><div class="shell"><div class="section-head"><span class="section-kicker">From concept to finished piece</span><h2>Built around the story behind the order.</h2><p>Command Deck turns ideas, milestones and identities into custom products people are proud to give, wear and keep.</p></div><div class="process-grid"><div class="process-card"><span class="num">01</span><h3>Share the idea</h3><p>Tell us what the piece represents, who it is for, and what success looks like.</p></div><div class="process-card"><span class="num">02</span><h3>Shape the design</h3><p>We translate your concept into a clear direction for review and refinement.</p></div><div class="process-card"><span class="num">03</span><h3>Approve the details</h3><p>Confirm the final artwork, quantities and production details before the order moves forward.</p></div><div class="process-card"><span class="num">04</span><h3>Make it real</h3><p>Your project moves into production and fulfillment with the details locked in.</p></div></div></div></section>
<section class="about-band" id="about"><div class="shell about-grid"><div class="about-mark"><img src="{{ 'command-deck-logo.webp' | asset_url }}" alt="{{ shop.name | escape }}"></div><div><span class="section-kicker">Command Deck Collectives LLC</span><h2 style="font-family:Georgia,serif;font-size:54px;font-weight:500;margin:15px 0">More than products. A higher purpose.</h2><p style="color:#c3bdb2;line-height:1.8">A veteran-owned custom products brand serving units, businesses, organizations and individuals with premium challenge coins, apparel, recognition pieces, engraved products and one-of-a-kind projects.</p><a class="btn secondary" href="/pages/custom-project">Start a project</a></div></div></section>
<section class="contact-band" id="contact"><div class="shell"><div class="contact-card"><div><span class="section-kicker">Custom orders</span><h2 style="font-family:Georgia,serif;font-size:54px;font-weight:500;margin:14px 0">Bring us the story. We’ll help build the piece.</h2><p style="color:#bdb7ad;line-height:1.75">Tell Command Deck what you want to create. Include the quantity, timeline and the meaning behind the project.</p></div>{% form 'contact', class: 'contact-form' %}<input required name="contact[name]" placeholder="Name"><input required type="email" name="contact[email]" placeholder="Email"><input name="contact[organization]" placeholder="Unit / business / organization"><select name="contact[project_type]"><option>Project type</option><option>Challenge coins</option><option>Apparel & merchandise</option><option>Awards & recognition</option><option>Bulk order</option><option>Custom project</option></select><textarea class="full" required name="contact[body]" placeholder="Tell us about the project, quantity, timeline, and what you want it to represent."></textarea><button class="btn primary full" type="submit">Start a Custom Project →</button>{% endform %}</div></div></section></main><footer class="footer"><div class="shell footer-grid"><img src="{{ 'command-deck-logo.webp' | asset_url }}" alt="{{ shop.name | escape }}"><small>© {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</small></div></footer>
{% schema %}{"name":"Command Deck homepage","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Custom products. Meaningful impact. Built to last."},{"type":"text","id":"headline_line_1","label":"Headline line 1","default":"Your Story"},{"type":"text","id":"headline_line_2","label":"Headline line 2","default":"In Every Detail."},{"type":"textarea","id":"lede","label":"Intro text","default":"Custom challenge coins, apparel, awards, engraved products, and premium merchandise for units, businesses, organizations, and individuals — designed to inspire, celebrate and leave a lasting legacy."},{"type":"text","id":"primary_label","label":"Primary button","default":"Start a Custom Project"},{"type":"url","id":"primary_link","label":"Primary link"},{"type":"text","id":"secondary_label","label":"Secondary button","default":"Shop Collections"},{"type":"url","id":"secondary_link","label":"Secondary link"}],"blocks":[{"type":"service","name":"Service","settings":[{"type":"text","id":"title","label":"Title","default":"Challenge Coins"},{"type":"text","id":"text","label":"Supporting text","default":"Custom designs. Lasting impact."},{"type":"url","id":"link","label":"Link"}]}],"presets":[{"name":"Command Deck homepage","blocks":[{"type":"service","settings":{"title":"Challenge Coins","text":"Custom designs. Lasting impact."}},{"type":"service","settings":{"title":"Apparel & Merchandise","text":"Wear the story."}},{"type":"service","settings":{"title":"Awards & Recognition","text":"Honor what matters."}},{"type":"service","settings":{"title":"Bulk Orders","text":"Custom. Consistent. High impact."}},{"type":"service","settings":{"title":"Custom Projects","text":"Your vision. Our craftsmanship."}}]}]}{% endschema %}
