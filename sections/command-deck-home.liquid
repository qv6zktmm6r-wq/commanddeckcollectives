
<header class="site-header"><div class="shell header-inner"><a class="brand" href="{{ routes.root_url }}"><span class="brand-mark"><img src="{{ 'command-deck-logo.webp' | asset_url }}" alt="{{ shop.name | escape }}"></span><span class="brand-label">Command Deck<br>Collectives, LLC</span></a><nav class="nav" aria-label="Primary"><a class="active" href="{{ routes.root_url }}">Home</a><a href="{{ routes.all_products_collection_url }}">Shop</a><a href="/pages/custom-project">Custom Orders</a><a href="#services">Services</a><a href="{{ routes.collections_url }}">Collections</a><a href="#our-work">Our Work</a><a href="#about">About</a><a href="#contact">Contact</a></nav><div class="header-actions"><a class="instagram-link" href="https://www.instagram.com/commanddeckllc/" target="_blank" rel="noopener noreferrer" aria-label="Command Deck Collectives on Instagram (opens in a new tab)"><img src="{{ 'instagram.svg' | asset_url }}" width="25" height="25" alt="Instagram"></a><a aria-label="Search" href="{{ routes.search_url }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="10.5" cy="10.5" r="7.5"/><path d="m16 16 5 5"/></svg></a><a aria-label="Account" href="{{ routes.account_url }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="7" r="4"/><path d="M3 21v-2a9 9 0 0 1 18 0v2Z"/></svg></a><a aria-label="Cart" href="{{ routes.cart_url }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 3h3l3 13h11l3-9H6"/><circle cx="9" cy="21" r="1"/><circle cx="19" cy="21" r="1"/></svg></a></div><button class="menu-toggle" data-menu-toggle aria-label="Menu" aria-expanded="false">☰</button></div><nav class="mobile-panel" data-mobile-panel aria-label="Mobile navigation"><a href="{{ routes.root_url }}">Home</a><a href="{{ routes.all_products_collection_url }}">Shop</a><a href="/pages/custom-project">Custom Orders</a><a href="#services">Services</a><a href="{{ routes.collections_url }}">Collections</a><a href="#our-work">Our Work</a><a href="#about">About</a><a href="#contact">Contact</a><a class="instagram-link" href="https://www.instagram.com/commanddeckllc/" target="_blank" rel="noopener noreferrer" aria-label="Command Deck Collectives on Instagram (opens in a new tab)"><img src="{{ 'instagram.svg' | asset_url }}" width="25" height="25" alt="Instagram"><span>@commanddeckllc</span></a></nav></header>
<main><section class="hero"><div class="hero-reference" aria-hidden="true"></div><div class="shell hero-inner"><div class="hero-copy"><p class="eyebrow">{{ section.settings.eyebrow }}</p><h1>{{ section.settings.headline_line_1 }} <span>{{ section.settings.headline_line_2 }}</span></h1><p class="hero-lede">{{ section.settings.lede }}</p><div class="hero-actions"><a class="btn primary" href="{{ section.settings.primary_link }}">{{ section.settings.primary_label }} →</a><a class="btn secondary" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label }}</a></div></div></div></section>
<section class="service-strip" id="services"><div class="service-grid">{% for block in section.blocks %}<a class="service-card" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>{% case forloop.index %}{% when 1 %}<span class="service-art"><img src="{{ 'lvt-2-water-buffalo-challenge-coin.png' | asset_url }}" alt="LVT-2 Water Buffalo collector coin from the Command Deck store" width="1536" height="1024" loading="eager"></span>{% when 2 %}<span class="service-art"><img src="{{ 'category-apparel.png' | asset_url }}" alt="Custom apparel concept with branded hoodie, cap and shirt" width="1536" height="1024" loading="eager"><small class="concept-label">Design concept</small></span>{% when 3 %}<span class="service-art"><img src="{{ 'category-awards.png' | asset_url }}" alt="Custom recognition concept with plaque and crystal award" width="1536" height="1024" loading="eager"><small class="concept-label">Design concept</small></span>{% when 4 %}<span class="service-art"><img src="{{ 'category-bulk.png' | asset_url }}" alt="Branded gift-box concept for bulk orders" width="1536" height="1024" loading="eager"><small class="concept-label">Design concept</small></span>{% when 5 %}<span class="service-art"><img src="{{ 'category-custom.png' | asset_url }}" alt="Custom medallion design concept on a workbench" width="1536" height="1024" loading="eager"><small class="concept-label">Design concept</small></span>{% endcase %}<span class="service-info"><h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p><span class="arrow">›</span></span></a>{% endfor %}</div></section>
<section class="trust"><div class="shell trust-grid"><div class="trust-item"><span class="trust-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2 3 6v6c0 5 9 10 9 10s9-5 9-10V6Z"/><path d="m13 6-5 7h4l-1 5 6-8h-4Z"/></svg></span><span><strong>Veteran Owned</strong><small>Service never stops</small></span></div><div class="trust-item"><span class="trust-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 2 3 7 8 1-6 5 2 8-7-4-7 4 2-8-6-5 8-1Z"/></svg></span><span><strong>Quality Craftsmanship</strong><small>Built to last</small></span></div><div class="trust-item"><span class="trust-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 2-.7 3-2 .8-2.6-1.5L1.5 8l2.2 2v3l-2.2 2 2.2 3.7 2.6-1.5 2 .8.7 3h5l.7-3 2-.8 2.6 1.5 2.2-3.7-2.2-2v-3l2.2-2-2.2-3.7-2.6 1.5-2-.8L14 2Z"/><circle cx="11.5" cy="11.5" r="3.5"/></svg></span><span><strong>Custom Designs</strong><small>Bring your vision to life</small></span></div><div class="trust-item"><span class="trust-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="6" r="3"/><circle cx="3.5" cy="9" r="2"/><circle cx="20.5" cy="9" r="2"/><path d="M6 22v-5a6 6 0 0 1 12 0v5ZM1 21v-6l3-2m19 8v-6l-3-2"/></svg></span><span><strong>Bulk Orders Welcome</strong><small>Teams · Businesses · Individuals</small></span></div><div class="trust-item"><span class="trust-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 5h13v14H1Zm13 5h5l4 5v4h-9"/><circle cx="6" cy="20" r="3" fill="#030303"/><circle cx="18" cy="20" r="3" fill="#030303"/></svg></span><span><strong>Fast Fulfillment</strong><small>Ready when you are</small></span></div></div></section>
<section class="featured-products content-section" id="featured-products"><div class="shell"><div class="products-heading"><div class="section-head"><span class="section-kicker">From the Command Deck store</span><h2>Stories you can hold.</h2><p>Explore our featured collector pieces. Visit the store for current pricing, availability, and checkout.</p></div><a class="btn secondary" href="https://commanddeckcollectives.com/collections/all">Shop all products →</a></div><div class="shop-product-grid"><a class="shop-product" href="https://commanddeckcollectives.com/products/aav-legacy-challenge-coin"><div class="shop-product-image"><img src="{{ 'aav-legacy-challenge-coin.png' | asset_url }}" alt="AAV Legacy Collection — front and reverse design" width="1254" height="1254" loading="lazy"></div><div class="shop-product-copy"><h3>AAV Legacy Collection</h3><p>A tribute to five generations of Marine Corps amphibious vehicles.</p><span class="product-cta">View in the store <span aria-hidden="true">↗</span></span></div></a><a class="shop-product" href="https://commanddeckcollectives.com/products/aztec-ega-collector-coin"><div class="shop-product-image"><img src="{{ 'aztec-ega-collector-coin.png' | asset_url }}" alt="Aztec Eagle, Globe and Anchor Collection — front and reverse design" width="1254" height="1254" loading="lazy"></div><div class="shop-product-copy"><h3>Aztec Eagle, Globe and Anchor Collection</h3><p>Aztec-inspired detail meets the Eagle, Globe, and Anchor.</p><span class="product-cta">View in the store <span aria-hidden="true">↗</span></span></div></a><a class="shop-product" href="https://commanddeckcollectives.com/products/lvt-2-water-buffalo-challenge-coin"><div class="shop-product-image"><img src="{{ 'lvt-2-water-buffalo-challenge-coin.png' | asset_url }}" alt="LVT-2 Water Buffalo Collection — front and reverse design" width="1254" height="1254" loading="lazy"></div><div class="shop-product-copy"><h3>LVT-2 Water Buffalo Collection</h3><p>A collectible honoring the Water Buffalo and its amphibious heritage.</p><span class="product-cta">View in the store <span aria-hidden="true">↗</span></span></div></a></div></div></section>
<section class="content-section" id="our-work"><div class="shell"><div class="section-head"><span class="section-kicker">From concept to finished piece</span><h2>Built around the story behind the order.</h2><p>Command Deck turns ideas, milestones and identities into custom products people are proud to give, wear and keep.</p></div><div class="process-grid"><div class="process-card"><span class="num">01</span><h3>Share the idea</h3><p>Tell us what the piece represents, who it is for, and what success looks like.</p></div><div class="process-card"><span class="num">02</span><h3>Shape the design</h3><p>We translate your concept into a clear direction for review and refinement.</p></div><div class="process-card"><span class="num">03</span><h3>Approve the details</h3><p>Confirm the final artwork, quantities and production details before the order moves forward.</p></div><div class="process-card"><span class="num">04</span><h3>Make it real</h3><p>Your project moves into production and fulfillment with the details locked in.</p></div></div></div></section>
<section class="about-band" id="about"><div class="shell about-grid"><div class="about-mark"><img src="{{ 'command-deck-logo.webp' | asset_url }}" alt="{{ shop.name | escape }}"></div><div><span class="section-kicker">Command Deck Collectives LLC</span><h2 style="font-family:Georgia,serif;font-size:54px;font-weight:500;margin:15px 0">More than products. A higher purpose.</h2><p style="color:#c3bdb2;line-height:1.8">A veteran-owned custom products brand serving units, businesses, organizations and individuals with premium challenge coins, apparel, recognition pieces, engraved products and one-of-a-kind projects.</p><a class="btn secondary" href="/pages/custom-project">Start a project</a></div></div></section>
<section class="contact-band" id="contact"><div class="shell"><div class="contact-card"><div><span class="section-kicker">Custom orders</span><h2 style="font-family:Georgia,serif;font-size:54px;font-weight:500;margin:14px 0">Bring us the story. We’ll help build the piece.</h2><p style="color:#bdb7ad;line-height:1.75">Tell Command Deck what you want to create. Include the quantity, timeline and the meaning behind the project.</p></div>{% form 'contact', class: 'contact-form' %}<input required name="contact[name]" placeholder="Name"><input required type="email" name="contact[email]" placeholder="Email"><input name="contact[organization]" placeholder="Unit / business / organization"><select name="contact[project_type]"><option>Project type</option><option>Challenge coins</option><option>Apparel & merchandise</option><option>Awards & recognition</option><option>Bulk order</option><option>Custom project</option></select><textarea class="full" required name="contact[body]" placeholder="Tell us about the project, quantity, timeline, and what you want it to represent."></textarea><button class="btn primary full" type="submit">Start a Custom Project →</button>{% endform %}</div></div></section></main><footer class="footer"><div class="shell footer-grid"><img src="{{ 'command-deck-logo.webp' | asset_url }}" alt="{{ shop.name | escape }}"><a class="instagram-link" href="https://www.instagram.com/commanddeckllc/" target="_blank" rel="noopener noreferrer" aria-label="Command Deck Collectives on Instagram (opens in a new tab)"><img src="{{ 'instagram.svg' | asset_url }}" width="25" height="25" alt="Instagram"><span>@commanddeckllc</span></a><small>© {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</small></div></footer>
{% schema %}{"name":"Command Deck homepage","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Custom products. Meaningful impact. Built to last."},{"type":"text","id":"headline_line_1","label":"Headline line 1","default":"Your Story"},{"type":"text","id":"headline_line_2","label":"Headline line 2","default":"In Every Detail."},{"type":"textarea","id":"lede","label":"Intro text","default":"Custom challenge coins, apparel, awards, engraved products, and premium merchandise for units, businesses, organizations, and individuals — designed to inspire, celebrate and leave a lasting legacy."},{"type":"text","id":"primary_label","label":"Primary button","default":"Start a Custom Project"},{"type":"url","id":"primary_link","label":"Primary link"},{"type":"text","id":"secondary_label","label":"Secondary button","default":"Shop Collections"},{"type":"url","id":"secondary_link","label":"Secondary link"}],"blocks":[{"type":"service","name":"Service","settings":[{"type":"text","id":"title","label":"Title","default":"Challenge Coins"},{"type":"text","id":"text","label":"Supporting text","default":"Custom designs. Lasting impact."},{"type":"url","id":"link","label":"Link"}]}],"presets":[{"name":"Command Deck homepage","blocks":[{"type":"service","settings":{"title":"Challenge Coins","text":"Custom designs. Lasting impact."}},{"type":"service","settings":{"title":"Apparel & Merchandise","text":"Wear the story."}},{"type":"service","settings":{"title":"Awards & Recognition","text":"Honor what matters."}},{"type":"service","settings":{"title":"Bulk Orders","text":"Custom. Consistent. High impact."}},{"type":"service","settings":{"title":"Custom Projects","text":"Your vision. Our craftsmanship."}}]}]}{% endschema %}
