{%- liquid
  assign fallback_images = 'lvt-2-water-buffalo-challenge-coin|category-apparel|category-awards|category-bulk|category-custom' | split: '|'
  assign fallback_alts = 'LVT-2 Water Buffalo collector coin from the Command Deck store|Custom apparel concept with branded hoodie, cap and shirt|Custom recognition concept with plaque and crystal award|Branded gift-box concept for bulk orders|Custom medallion design concept on a workbench' | split: '|'
-%}
<div class="cd">
<section class="hero">
  <div class="hero-reference" aria-hidden="true"></div>
  <div class="shell hero-inner">
    <div class="hero-copy">
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h1>{{ section.settings.headline_line_1 }} <span>{{ section.settings.headline_line_2 }}</span></h1>
      <p class="hero-lede">{{ section.settings.lede }}</p>
      <div class="hero-actions">
        <a class="btn primary" href="{{ section.settings.primary_link | default: '/pages/custom-project' }}">{{ section.settings.primary_label }} →</a>
        <a class="btn secondary" href="{{ section.settings.secondary_link | default: routes.all_products_collection_url }}">{{ section.settings.secondary_label }}</a>
      </div>
    </div>
  </div>
</section>

<section class="service-strip" id="services" aria-labelledby="services-heading">
  <h2 class="visually-hidden" id="services-heading">What we make</h2>
  <div class="service-grid">
    {%- assign service_blocks = section.blocks | where: 'type', 'service' -%}
    {%- for block in service_blocks -%}
      {%- assign index = forloop.index0 -%}
      <a class="service-card" href="{{ block.settings.link | default: '/pages/custom-project' }}" {{ block.shopify_attributes }}>
        <span class="service-art">
          {%- if block.settings.image != blank -%}
            {%- assign art_alt = block.settings.image.alt | default: block.settings.title -%}
            {{ block.settings.image | image_url: width: 960 | image_tag: widths: '480, 720, 960', sizes: '(max-width: 700px) 50vw, (max-width: 1000px) 33vw, 20vw', loading: 'lazy', alt: art_alt }}
            {%- if block.settings.concept_label -%}<small class="concept-label">Design concept</small>{%- endif -%}
          {%- elsif index == 0 -%}
            {%- assign art = fallback_images[index] -%}
            <img src="{{ art | append: '.webp' | asset_url }}" srcset="{{ art | append: '-500.webp' | asset_url }} 500w, {{ art | append: '.webp' | asset_url }} 1000w" sizes="(max-width: 700px) 50vw, (max-width: 1000px) 33vw, 20vw" loading="lazy" decoding="async" alt="{{ fallback_alts[index] }}" width="1000" height="1000">
          {%- elsif fallback_images[index] -%}
            {%- assign art = fallback_images[index] -%}
            <img src="{{ art | append: '.webp' | asset_url }}" srcset="{{ art | append: '-480.webp' | asset_url }} 480w, {{ art | append: '.webp' | asset_url }} 960w" sizes="(max-width: 700px) 50vw, (max-width: 1000px) 33vw, 20vw" loading="lazy" decoding="async" alt="{{ fallback_alts[index] }}" width="960" height="640">
            <small class="concept-label">Design concept</small>
          {%- endif -%}
        </span>
        <div class="service-info"><h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p><span class="arrow" aria-hidden="true">›</span></div>
      </a>
    {%- endfor -%}
  </div>
</section>

<section class="trust" aria-label="Why Command Deck">
  <div class="shell trust-grid">
    <div class="trust-item"><span class="trust-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2 3 6v6c0 5 9 10 9 10s9-5 9-10V6Z"/><path d="m13 6-5 7h4l-1 5 6-8h-4Z"/></svg></span><span><strong>Veteran Owned</strong><small>Service never stops</small></span></div>
    <div class="trust-item"><span class="trust-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 2 3 7 8 1-6 5 2 8-7-4-7 4 2-8-6-5 8-1Z"/></svg></span><span><strong>Quality Craftsmanship</strong><small>Built to last</small></span></div>
    <div class="trust-item"><span class="trust-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 2-.7 3-2 .8-2.6-1.5L1.5 8l2.2 2v3l-2.2 2 2.2 3.7 2.6-1.5 2 .8.7 3h5l.7-3 2-.8 2.6 1.5 2.2-3.7-2.2-2v-3l2.2-2-2.2-3.7-2.6 1.5-2-.8L14 2Z"/><circle cx="11.5" cy="11.5" r="3.5"/></svg></span><span><strong>Custom Designs</strong><small>Bring your vision to life</small></span></div>
    <div class="trust-item"><span class="trust-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="6" r="3"/><circle cx="3.5" cy="9" r="2"/><circle cx="20.5" cy="9" r="2"/><path d="M6 22v-5a6 6 0 0 1 12 0v5ZM1 21v-6l3-2m19 8v-6l-3-2"/></svg></span><span><strong>Bulk Orders Welcome</strong><small>Teams · Businesses · Individuals</small></span></div>
    <div class="trust-item"><span class="trust-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 5h13v14H1Zm13 5h5l4 5v4h-9"/><circle cx="6" cy="20" r="3" fill="#030303"/><circle cx="18" cy="20" r="3" fill="#030303"/></svg></span><span><strong>Fast Fulfillment</strong><small>Ready when you are</small></span></div>
  </div>
</section>

<section class="featured-products content-section" id="featured-products">
  <div class="shell">
    <div class="products-heading">
      <div class="section-head">
        <span class="section-kicker">From the Command Deck store</span>
        <h2>Stories you can hold.</h2>
        <p>Explore our featured collector pieces. Visit the store for current pricing, availability, and checkout.</p>
      </div>
      <a class="btn secondary" href="{{ routes.all_products_collection_url }}">Shop all products →</a>
    </div>
    <div class="shop-product-grid">
      {%- liquid
        assign product_blocks = section.blocks | where: 'type', 'product'
        assign fallback_handles = 'aav-legacy-challenge-coin|aztec-ega-collector-coin|lvt-2-water-buffalo-challenge-coin' | split: '|'
        assign fallback_titles = 'AAV Legacy Collection|Aztec Eagle, Globe and Anchor Collection|LVT-2 Water Buffalo Collection' | split: '|'
        assign fallback_text = 'A tribute to five generations of Marine Corps amphibious vehicles.|Aztec-inspired detail meets the Eagle, Globe, and Anchor.|A collectible honoring the Water Buffalo and its amphibious heritage.' | split: '|'
        assign live_count = 0
        for block in product_blocks
          if block.settings.product != blank
            assign live_count = live_count | plus: 1
          endif
        endfor
      -%}
      {%- if live_count > 0 -%}
        {%- for block in product_blocks -%}
          {%- assign product = block.settings.product -%}
          {%- if product != blank -%}
            <a class="shop-product" href="{{ product.url }}" {{ block.shopify_attributes }}>
              <div class="shop-product-image">
                {%- if product.featured_image -%}
                  {%- assign product_alt = product.featured_image.alt | default: product.title -%}
                  {{ product.featured_image | image_url: width: 1000 | image_tag: widths: '400, 600, 800, 1000', sizes: '(max-width: 700px) 100vw, 33vw', loading: 'lazy', alt: product_alt }}
                {%- endif -%}
              </div>
              <div class="shop-product-copy">
                <h3>{{ product.title | escape }}</h3>
                <p>{{ block.settings.text | default: product.description | strip_html | truncatewords: 16 }}</p>
                <span class="product-cta">
                  <span>{% if product.available %}{{ product.price | money }}{% else %}Sold out{% endif %}</span>
                  <span>View <span aria-hidden="true">↗</span></span>
                </span>
              </div>
            </a>
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        {%- for handle in fallback_handles -%}
          <a class="shop-product" href="/products/{{ handle }}">
            <div class="shop-product-image"><img src="{{ handle | append: '.webp' | asset_url }}" srcset="{{ handle | append: '-500.webp' | asset_url }} 500w, {{ handle | append: '.webp' | asset_url }} 1000w" sizes="(max-width: 700px) 100vw, 33vw" alt="{{ fallback_titles[forloop.index0] }} — front and reverse design" width="1000" height="1000" loading="lazy"></div>
            <div class="shop-product-copy"><h3>{{ fallback_titles[forloop.index0] }}</h3><p>{{ fallback_text[forloop.index0] }}</p><span class="product-cta">View in the store <span aria-hidden="true">↗</span></span></div>
          </a>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{%- assign gallery_blocks = section.blocks | where: 'type', 'gallery_image' -%}
{%- assign gallery_count = 0 -%}
{%- for block in gallery_blocks -%}
  {%- if block.settings.image != blank -%}{%- assign gallery_count = gallery_count | plus: 1 -%}{%- endif -%}
{%- endfor -%}
{%- if gallery_count > 0 -%}
  <section class="content-section gallery-section" id="recent-work">
    <div class="shell">
      <div class="section-head">
        <span class="section-kicker">Recent work</span>
        <h2>{{ section.settings.gallery_heading }}</h2>
      </div>
      <ul class="gallery-grid">
        {%- for block in gallery_blocks -%}
          {%- if block.settings.image != blank -%}
            {%- render 'cd-gallery-item', block: block, image: block.settings.image, title: block.settings.caption, sizes: '(max-width: 620px) 50vw, 25vw' -%}
          {%- endif -%}
        {%- endfor -%}
      </ul>
      <a class="btn secondary gallery-more" href="/pages/our-work">See all our work →</a>
    </div>
  </section>
  {%- render 'cd-lightbox' -%}
{%- endif -%}

<section class="content-section" id="how-it-works">
  <div class="shell">
    <div class="section-head">
      <span class="section-kicker">From concept to finished piece</span>
      <h2>Built around the story behind the order.</h2>
      <p>Command Deck turns ideas, milestones and identities into custom products people are proud to give, wear and keep.</p>
    </div>
    <ol class="process-grid">
      <li class="process-card"><span class="num">01</span><h3>Share the idea</h3><p>Tell us what the piece represents, who it is for, and what success looks like.</p></li>
      <li class="process-card"><span class="num">02</span><h3>Shape the design</h3><p>We translate your concept into a clear direction for review and refinement.</p></li>
      <li class="process-card"><span class="num">03</span><h3>Approve the details</h3><p>Confirm the final artwork, quantities and production details before the order moves forward.</p></li>
      <li class="process-card"><span class="num">04</span><h3>Make it real</h3><p>Your project moves into production and fulfillment with the details locked in.</p></li>
    </ol>
  </div>
</section>

{%- assign testimonial_blocks = section.blocks | where: 'type', 'testimonial' -%}
{%- assign testimonial_count = 0 -%}
{%- for block in testimonial_blocks -%}
  {%- if block.settings.quote != blank -%}{%- assign testimonial_count = testimonial_count | plus: 1 -%}{%- endif -%}
{%- endfor -%}
{%- if testimonial_count > 0 -%}
  <section class="content-section testimonials-section" id="testimonials">
    <div class="shell">
      <div class="section-head">
        <span class="section-kicker">In their words</span>
        <h2>{{ section.settings.testimonials_heading }}</h2>
      </div>
      <ul class="testimonial-grid">
        {%- for block in testimonial_blocks -%}
          {%- if block.settings.quote != blank -%}
            <li class="testimonial-card" {{ block.shopify_attributes }}>
              <blockquote>{{ block.settings.quote | escape | newline_to_br }}</blockquote>
              {%- if block.settings.name != blank -%}
                <p class="testimonial-author">{{ block.settings.name | escape }}{% if block.settings.role != blank %}<span>{{ block.settings.role | escape }}</span>{% endif %}</p>
              {%- endif -%}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  </section>
{%- endif -%}

<section class="about-band" id="about">
  <div class="shell about-grid">
    <div class="about-mark"><img src="{{ 'command-deck-logo.webp' | asset_url }}" alt="{{ shop.name | escape }} crest" width="1036" height="920" loading="lazy"></div>
    <div>
      <span class="section-kicker">Command Deck Collective</span>
      <h2>More than products. A higher purpose.</h2>
      <p>A veteran-owned custom products brand serving units, businesses, organizations and individuals with premium challenge coins, apparel, recognition pieces, engraved products and one-of-a-kind projects.</p>
      <a class="btn secondary" href="/pages/custom-project">Start a project</a>
    </div>
  </div>
</section>

<section class="contact-band" id="contact">
  <div class="shell">
    <div class="contact-card">
      <div>
        <span class="section-kicker">Custom orders</span>
        <h2>Bring us the story. We’ll help build the piece.</h2>
        <p>Tell Command Deck what you want to create. Include the quantity, timeline and the meaning behind the project.</p>
      </div>
      {%- render 'cd-contact-form', form_id: 'ContactForm-home' -%}
    </div>
  </div>
</section>
</div>

{% schema %}
{
  "name": "Command Deck homepage",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Custom products. Meaningful impact. Built to last." },
    { "type": "text", "id": "headline_line_1", "label": "Headline line 1", "default": "Your Story" },
    { "type": "text", "id": "headline_line_2", "label": "Headline line 2", "default": "In Every Detail." },
    { "type": "textarea", "id": "lede", "label": "Intro text", "default": "Custom challenge coins, apparel, awards, engraved products, and premium merchandise for units, businesses, organizations, and individuals — designed to inspire, celebrate and leave a lasting legacy." },
    { "type": "text", "id": "primary_label", "label": "Primary button", "default": "Start a Custom Project" },
    { "type": "url", "id": "primary_link", "label": "Primary link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button", "default": "Shop Collections" },
    { "type": "url", "id": "secondary_link", "label": "Secondary link" },
    { "type": "text", "id": "gallery_heading", "label": "Gallery heading", "default": "Pieces we’ve made.", "info": "The gallery only appears once a Gallery photo block has an image." },
    { "type": "text", "id": "testimonials_heading", "label": "Testimonials heading", "default": "What customers say.", "info": "Testimonials only appear once a Testimonial block has a quote. Use real customer words only." }
  ],
  "blocks": [
    {
      "type": "service",
      "name": "Service",
      "limit": 5,
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Challenge Coins" },
        { "type": "text", "id": "text", "label": "Supporting text", "default": "Custom designs. Lasting impact." },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Leave empty to use the bundled category art." },
        { "type": "checkbox", "id": "concept_label", "label": "Show \"Design concept\" label on uploaded image", "default": false }
      ]
    },
    {
      "type": "product",
      "name": "Featured product",
      "limit": 3,
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "text", "label": "Short description", "info": "Leave empty to use the start of the product description." }
      ]
    },
    {
      "type": "gallery_image",
      "name": "Gallery photo",
      "limit": 12,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "text", "id": "caption", "label": "Caption", "info": "Shown under the photo. Add alt text to the image itself to describe what it shows." }
      ]
    },
    {
      "type": "testimonial",
      "name": "Testimonial",
      "limit": 6,
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote" },
        { "type": "text", "id": "name", "label": "Name" },
        { "type": "text", "id": "role", "label": "Unit, business or role" }
      ]
    }
  ],
  "max_blocks": 26,
  "presets": [
    {
      "name": "Command Deck homepage",
      "blocks": [
        { "type": "service", "settings": { "title": "Challenge Coins", "text": "Custom designs. Lasting impact." } },
        { "type": "service", "settings": { "title": "Apparel & Merchandise", "text": "Wear the story." } },
        { "type": "service", "settings": { "title": "Awards & Recognition", "text": "Honor what matters." } },
        { "type": "service", "settings": { "title": "Bulk Orders", "text": "Custom. Consistent. High impact." } },
        { "type": "service", "settings": { "title": "Custom Projects", "text": "Your vision. Our craftsmanship." } }
      ]
    }
  ]
}
{% endschema %}
